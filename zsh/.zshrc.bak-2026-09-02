### oh my zsh

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
#ZSH_TEME="agnoster"
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  emoji-clock
  themes
)
source $ZSH/oh-my-zsh.sh


### path

# Aggiunge ~/.local/bin al PATH solo se non c'è già (evita duplicati).
# PATH è la lista di cartelle in cui la shell cerca i comandi: così puoi
# lanciare gli script in ~/.local/bin (es. install-all-packages.sh) da ovunque.
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"

### rbenv

export PATH="$HOME/.rbenv/shims:$HOME/.rbenv/bin:$PATH"
eval "$(rbenv init - zsh)"


