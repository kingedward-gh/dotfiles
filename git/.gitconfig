[user]
	name = Eduardo G
	email = 304043171+kingedward-gh@users.noreply.github.com
[core]
	editor = ~/.local/bin/git-editor
	hooksPath = ~/.config/git/hooks
[alias]
	aliases = config --get-regexp '^alias\\.'
# Portable across Arch (mise) and macOS (Homebrew). gh auth setup-git would
# replace these with an absolute path and break the other machine.
[credential "https://github.com"]
	helper = 
	helper = !~/.local/bin/gh-git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !~/.local/bin/gh-git-credential
