#!/bin/sh
# Git credential helper. Git calls this with one argument: get, store, or erase.
# Finds gh on Arch (mise) and macOS (Homebrew) so one gitconfig works on both.

if command -v gh >/dev/null 2>&1; then
  exec gh auth git-credential "$@"
fi

for candidate in \
  /opt/homebrew/bin/gh \
  /usr/local/bin/gh \
  "$HOME/.local/bin/gh" \
  "$HOME/.local/share/mise/shims/gh"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" auth git-credential "$@"
  fi
done

echo "gh-git-credential: gh not found" >&2
exit 1
