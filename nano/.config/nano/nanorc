# ==============================================================================
# [COMMON]
# Syntax files are reached through symlinks that zsh refreshes on startup
# (see link_nano_syntax in ~/.zshrc). On Arch those point at
# /usr/share/nano, because /etc/nanorc leaves the includes commented out.
# On macOS they point at an empty dir: Homebrew already loads
# /opt/homebrew/share/nano/*.nanorc from /opt/homebrew/etc/nanorc.
# ==============================================================================

include "~/.local/share/nano/syntax/*.nanorc"
include "~/.local/share/nano/syntax-extra/*.nanorc"

set linenumbers
set autoindent
set tabsize 2
set tabstospaces
set softwrap
set atblanks
set constantshow
set indicator
set positionlog
set smarthome
set zap
set colonparsing

# Named colors follow the terminal palette (Catppuccin Latte in iTerm).
# Nano 9 rejects #RRGGBB here.
set titlecolor bold,white,blue
set statuscolor bold,black,white
set promptcolor black,white
set numbercolor blue
set keycolor blue
set functioncolor cyan
set selectedcolor white,blue
set errorcolor bold,white,red
