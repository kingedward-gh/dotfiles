# Shared OS, editor and personal ignore rules (managed per repository).

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Editors
*.swp
*.swo
.idea/
.cursor
.vscode
*.code-workspace
statsig-cache.json

# Backup leftovers
*.bak
*.tmp
*.orig

# Secrets safety net (Rails still keeps /.env* in the project gitignore)
.env
.env.*
!.env.example

# edu's ignores below ------------------------------------------------------------

# Personal scratch (never commit)
_ignore/
_global

# Repository-specific rules

# ignores for this repo below --------------------------------------------------

# cliamp runtime (config dir is folded into the repo)
cliamp/.config/cliamp/*.log
cliamp/.config/cliamp/*.lock
cliamp/.config/cliamp/*.pid
cliamp/.config/cliamp/*.sock
cliamp/.config/cliamp/history.toml
cliamp/.config/cliamp/radio_favorites.toml

# Alfred: snippets stay on disk for Alfred, but not in git (passwords, PII)
alfred/Alfred.alfredpreferences/snippets/
alfred/Alfred.alfredpreferences/clipboard/
