# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Bundler config
/.bundle

# Environment files
/.env*

# Key files for decrypting credentials and more
/config/*.key

# Kamal secrets
.kamal/secrets

# Logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Storage (uploaded files in development and any SQLite databases)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Pidfiles
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Backups
*.bak
*.tmp
*.orig

# Generated Entity-Relationship diagrams
/erd.png

# Build assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Public assets
/public/assets

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Editors
*.swp
*.swo
.idea/
.cursor
.vscode
*.code-workspace

# Edu
_ignore/
