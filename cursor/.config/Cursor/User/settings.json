{
    "editor.renderWhitespace": "all",
    "editor.multiCursorModifier": "ctrlCmd",
    "workbench.preferredLightColorTheme": "Catppuccin Latte",
    "workbench.preferredDarkColorTheme": "Default Dark Modern",
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "cursor.composer.usageSummaryDisplay": "always",
    "git.confirmSync": false,
    "bookmarks.treeLabelMode": "name",
    "diffEditor.renderSideBySide": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "explorer.confirmDelete": false,
    "workbench.colorTheme": "Catppuccin Latte",
    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace",
    "files.exclude": {
        // "**/.git": false
    },
    "editor.wordWrap": "on",
    "cursor.composer.conversationDensity": "compact-ungrouped",
    "cursor.composer.codeBlockWordWrap": true,
    "workbench.reduceMotion": "on",
    "cursor.general.emailPrivacyEnabled": true,
    "cursor.worktreeMaxCount": 20,
    "markdown.validate.enabled": true,
    "editor.tabSize": 2,
    "[yaml]": {
        "editor.tabSize": 2
    },
    "editor.cursorStyle": "block",
    "workbench.iconTheme": "catppuccin-latte"
}